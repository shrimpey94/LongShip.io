rules_version = '2';
// Longship.io: anyone can read the boards and add a score. Only admins can delete one.
// Signed-in players can read and save only their own progress.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function validScore(d) {
      return d.keys().hasOnly(['name', 'score', 'kills', 'day', 'skin', 'rid', 'ts'])
        && d.keys().hasAll(['name', 'score', 'kills', 'day', 'skin', 'rid', 'ts'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 15
        && d.score is int && d.score >= 10 && d.score <= 20000
        && d.kills is int && d.kills >= 0 && d.kills <= 1000
        && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.skin is string && d.skin.size() <= 20
        && d.rid is string && d.rid.size() <= 30
        && d.ts == request.time;
    }
    match /scores/{id} {
      allow read: if true;
      allow create: if validScore(request.resource.data);
      allow delete: if isAdmin();
    }
    match /daily/{day}/scores/{id} {
      allow read: if true;
      allow create: if validScore(request.resource.data) && request.resource.data.day == day;
      allow delete: if isAdmin();
    }
    // each signed-in player's saved unlocks; only they can read or change their own
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && request.resource.data.size() < 20;
      allow delete: if false;
    }
    // you add yourself here by hand in the Firebase console; the game only checks it
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
